# Set these in your local .env, shell or secret manager. The CLI loads .env without overriding shell settings.
GMAIL_ACCESS_TOKEN=
GMAIL_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_QUERY='from:harishaditya866@gmail.com to:harishaditya1308@gmail.com subject:"NovaCRM Onboarding"'
ROCKETLANE_API_KEY=
# Real numeric project ID used by: python -m app.check_rocketlane
ROCKETLANE_PROJECT_ID=
# Tenant-specific task status values; copy verified values from your Rocketlane configuration.
# JSON object with keys not_started, in_progress, blocked, completed. Do not guess numeric values.
ROCKETLANE_TASK_STATUS_VALUES=
# Copy a verified task URL from your tenant and replace IDs with {project_id} and {task_id}.
ROCKETLANE_TASK_URL_TEMPLATE=
ROCKETLANE_OWNER_EMAIL=
ENTERPRISE_CSM_EMAIL=
GROWTH_CSM_EMAIL=
# Copy valid sources arrays from your tenant API reference; keep plan template durations at 30/14 days.
ENTERPRISE_TEMPLATE_SOURCES=
GROWTH_TEMPLATE_SOURCES=
SLACK_BOT_TOKEN=
# Existing customer email lookup needs users:read.email. External Connect invitations are opt-in.
# manual: pause for an administrator when lookup cannot add an existing member.
# connect: try conversations.inviteShared with conversations.connect:write and tenant eligibility.
SLACK_CUSTOMER_INVITE_MODE=manual
# Existing workspace members to add after explicit plan confirmation (comma-separated Slack user IDs).
SLACK_SHARED_TEAM_USER_IDS=
ENTERPRISE_SLACK_TEAM_USER_IDS=
GROWTH_SLACK_TEAM_USER_IDS=
